APP_NAME="Intelligent Exam System API"
# Railway automatically provides this for a linked PostgreSQL service.
DATABASE_URL="postgresql://postgres:password@host:5432/railway"
MALPRACTICE_WEBHOOK_URL="https://aistudio.google.com/"
# Set this in Railway to enable voice-note transcription. Never put this key
# in the Flutter app or commit the real value to source control.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
# Keep this below Railway's request timeout. Values are clamped to 5–30 seconds.
GEMINI_TIMEOUT_SECONDS="18"
